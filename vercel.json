{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/command-hub/:event/register",
      "destination": "/register.html?event=:event"
    },
    {
      "source": "/command-hub/:event/portal",
      "destination": "/contestant-portal.html?event=:event"
    },
    {
      "source": "/command-hub/:event/judges",
      "destination": "/judges.html?event=:event"
    },
    {
      "source": "/command-hub/:event/leaderboard",
      "destination": "/leaderboard.html?event=:event"
    },
    {
      "source": "/command-hub/:event/channel",
      "destination": "/channel-hub.html?event=:event"
    },
    {
      "source": "/command-hub/:event",
      "destination": "/index.html?event=:event"
    },
    {
      "source": "/command-hub",
      "destination": "/index.html"
    }
  ]
}
