{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "img/**",
      "use": "@vercel/static"
    },
    {
      "src": "scripts/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/command-hub/([^/]+)/register",
      "dest": "/register.html?event=$1"
    },
    {
      "src": "/command-hub/([^/]+)/portal",
      "dest": "/contestant-portal.html?event=$1"
    },
    {
      "src": "/command-hub/([^/]+)/judges",
      "dest": "/judges.html?event=$1"
    },
    {
      "src": "/command-hub/([^/]+)/leaderboard",
      "dest": "/leaderboard.html?event=$1"
    },
    {
      "src": "/command-hub/([^/]+)/channel",
      "dest": "/channel-hub.html?event=$1"
    },
    {
      "src": "/command-hub/([^/]+)",
      "dest": "/index.html?event=$1"
    },
    {
      "src": "/command-hub",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
